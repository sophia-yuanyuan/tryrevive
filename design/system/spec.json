{
  "colors": {
    "primary": "#FF8A65",
    "bg": "#FFFFFF",
    "bgSoft": "#F9FAFB",
    "bgQuiet": null,
    "ink": "#000000",
    "inkSoft": "#4B5563",
    "muted": "#9CA3AF",
    "mutedSoft": null,
    "accent": "#1E1E1E",
    "line": "rgba(229, 231, 235, 1.0)",
    "principle": "High-contrast neutrals with Tryrevive Warm Coral (#FF8A65) reserved for primary actions, active states, and focus."
  },
  "typography": {
    "display": "sans-serif",
    "body": "sans-serif",
    "mono": "monospace",
    "scale": [
      {
        "token": "display",
        "size": 56,
        "lh": 1.1,
        "weight": 400,
        "ls": "-1px",
        "use": "Primary headline (Own your AI)"
      },
      {
        "token": "headline",
        "size": 32,
        "lh": 1.2,
        "weight": 400,
        "ls": "0px",
        "use": "Subheadline (Your data...)"
      },
      {
        "token": "body",
        "size": 16,
        "lh": 1.5,
        "weight": 400,
        "ls": "0px",
        "use": "Standard body text"
      },
      {
        "token": "caption",
        "size": 14,
        "lh": 1.4,
        "weight": 400,
        "ls": "0px",
        "use": "Secondary information"
      }
    ],
    "rules": [
      "Display font is highly legible sans-serif.",
      "Body text uses standard system font stack fallback.",
      "Monospace for code elements."
    ]
  },
  "spacing": {
    "base": 4,
    "scale": [
      4,
      8,
      16,
      24,
      32,
      48,
      64,
      96
    ],
    "rhythm": "Generous whitespace and standard 8pt-based spacing scale."
  },
  "surfaces": {
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "pill": 999
    },
    "shadows": [
      "0px 4px 6px -1px rgba(0, 0, 0, 0.1)"
    ],
    "borders": "1px solid #E5E7EB"
  },
  "layout": {
    "container": 1200,
    "paragraph": 680,
    "columns": 12,
    "gutter": 24,
    "breakpoints": [
      768,
      1024
    ],
    "skeleton": "Standard 12-column grid with centered container."
  },
  "motion": {
    "durations": {
      "micro": 220,
      "small": 400,
      "medium": 800
    },
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "patterns": [
      "Smooth transitions for hover states.",
      "Subtle fade-ins for content sections."
    ]
  }
}
