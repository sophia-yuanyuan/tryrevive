{
  "$schema": "https://tr.designtokens.org/component.schema.json",
  "button": {
    "height": { "sm": "{ref.size.controlSm}", "md": "{ref.size.controlMd}", "lg": "{ref.size.controlLg}" },
    "radius": "{ref.radius.full}",
    "paddingInline": { "sm": "{ref.space.4}", "md": "{ref.space.5}", "lg": "{ref.space.6}" },
    "gap": "{ref.space.2}",
    "primaryBg": "{semantic.color.action}",
    "primaryBgHover": "{semantic.color.actionHover}",
    "primaryBgPressed": "{semantic.color.actionPressed}",
    "primaryText": "{semantic.color.onAction}",
    "secondaryBg": "{semantic.color.surface}",
    "secondaryText": "{semantic.color.text}",
    "border": "{semantic.color.borderStrong}"
  },
  "field": {
    "height": "{ref.size.controlLg}",
    "radius": "{ref.radius.lg}",
    "paddingInline": "{ref.space.4}",
    "gap": "{ref.space.2}",
    "bg": "{semantic.color.surface}",
    "text": "{semantic.color.text}",
    "placeholder": "{semantic.color.textTertiary}",
    "border": "{semantic.color.borderStrong}",
    "borderHover": "{semantic.color.textTertiary}",
    "borderFocus": "{semantic.color.focus}"
  },
  "card": {
    "radius": "{ref.radius.xl}",
    "padding": "clamp(1.25rem, 4vw, 2.5rem)",
    "bg": "{semantic.color.surface}",
    "border": "{semantic.color.border}",
    "shadow": "{ref.shadow.md}"
  },
  "chip": {
    "height": "{ref.size.controlSm}",
    "radius": "{ref.radius.full}",
    "paddingInline": "{ref.space.3}",
    "bg": "{semantic.color.surfaceSunken}",
    "text": "{semantic.color.textSecondary}",
    "selectedBg": "{semantic.color.actionSubtle}",
    "selectedText": "{semantic.color.action}"
  },
  "dialog": {
    "radius": "{ref.radius.2xl}",
    "padding": "clamp(1.25rem, 4vw, 2rem)",
    "bg": "{semantic.color.surfaceRaised}",
    "scrim": "{semantic.color.overlay}",
    "shadow": "{ref.shadow.lg}"
  },
  "navigation": {
    "height": "4.5rem",
    "bg": "{semantic.color.surfaceGlass}",
    "border": "{semantic.color.border}",
    "blur": "{ref.blur.md}"
  },
  "focusRing": {
    "width": "{ref.border.focus}",
    "color": "{semantic.color.focus}",
    "offset": "3px",
    "shadow": "{ref.shadow.focus}"
  }
}
