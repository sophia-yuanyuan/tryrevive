{
  "name": "tryrevive",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Student-first stalled-project revival app for web and desktop.",
  "author": "TryRevive",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "electron-vite dev",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron:install": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/install-electron.ps1",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "node --test worker/cloud-core.test.mjs worker/cloud-service-core.test.mjs worker/cloud-d1-repository.test.mjs worker/openai-project-provider.test.mjs worker/stripe-checkout-provider.test.mjs",
    "test:focus:windows": "node --test tests/integration/foreground-monitor.test.mjs",
    "test:e2e": "playwright test --config playwright.config.mjs tests/e2e/web.spec.mjs",
    "test:e2e:desktop": "npm run electron:install && npm run build:desktop && playwright test --config playwright.config.mjs tests/e2e/desktop.spec.mjs --project electron",
    "test:e2e:packaged": "set \"ELECTRON_EXECUTABLE_PATH=release\\win-unpacked\\TryRevive.exe\" && playwright test --config playwright.config.mjs tests/e2e/desktop.spec.mjs --project electron",
    "test:e2e:remote-cloud": "node --test tests/remote/cloud-production.e2e.mjs",
    "build:web": "npm run typecheck && vite build",
    "build:desktop": "npm run typecheck && electron-vite build",
    "dist:win": "npm run electron:install && npm run build:desktop && electron-builder --win --publish never",
    "verify:dist:win": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-artifacts.ps1",
    "verify:production": "node scripts/verify-production-control-plane.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:worker && npm run test:focus:windows && npm run build:web && npm run build:desktop"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "electron": "42.8.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.66.0",
    "vite": "7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wrangler": "4.120.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
